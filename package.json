{
  "name": "cloud-agent",
  "version": "0.3.0-preview.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "dev:api": "tsx --conditions=development watch apps/api/main.ts",
    "dev:worker": "tsx --conditions=development watch apps/worker/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts && node scripts/copy-notices.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=development --test --test-concurrency=1 tests/*.test.ts",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "playwright test",
    "lint": "eslint packages adapters modules apps scripts tests && node scripts/check-boundaries.mjs",
    "format": "prettier --write packages adapters modules apps scripts tests '*.json' '*.yaml' '*.mjs' 'playwright.config.ts' .github",
    "format:check": "prettier --check packages adapters modules apps scripts tests '*.json' '*.yaml' '*.mjs' 'playwright.config.ts' .github",
    "migrate": "tsx --conditions=development scripts/migrate.ts",
    "bootstrap": "tsx --conditions=development scripts/bootstrap.ts",
    "check": "pnpm docs:check && pnpm typecheck && pnpm lint && pnpm test:tooling && pnpm test:coverage && pnpm build",
    "test:coverage": "node scripts/test-integration.mjs --coverage",
    "provision": "tsx --conditions=development scripts/provision.ts",
    "test:compose": "node scripts/smoke-compose.mjs",
    "bootstrap:admin": "tsx --conditions=development scripts/bootstrap-admin.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "licenses:generate": "node scripts/third-party-notices.mjs",
    "licenses:check": "node scripts/third-party-notices.mjs --check",
    "mail:webhook": "tsx --conditions=development scripts/register-mail-webhook.ts",
    "module:create": "node scripts/create-module.mjs",
    "archive": "tsx --conditions=development scripts/archive.ts",
    "doctor": "tsx --conditions=development scripts/doctor.ts",
    "extension:create": "node scripts/create-extension.mjs",
    "files:prune": "tsx --conditions=development scripts/prune-files.ts",
    "package:create": "node scripts/create-package.mjs",
    "migrate:business": "tsx --conditions=development scripts/migrate-business.ts",
    "deployment": "tsx --conditions=development scripts/deployment.ts",
    "benchmark": "tsx --conditions=development scripts/benchmark.ts",
    "retention": "tsx --conditions=development scripts/retention.ts",
    "recovery": "tsx --conditions=development scripts/recovery.ts",
    "sdk:build": "pnpm build && node scripts/package-sdk.mjs",
    "sdk:verify": "node scripts/package-sdk.mjs && node scripts/verify-sdk.mjs",
    "maintenance": "tsx --conditions=development scripts/maintenance.ts",
    "evaluate": "tsx --conditions=development scripts/evaluate.ts",
    "contracts:check": "tsx --conditions=development scripts/check-contracts.ts",
    "contracts:update": "tsx --conditions=development scripts/check-contracts.ts --write",
    "supply-chain:check": "pnpm audit --prod --audit-level high",
    "sbom": "node scripts/sbom.mjs",
    "test:recovery": "tsx --conditions=development scripts/recovery-drill.ts",
    "test:tooling": "node --test scripts/*.test.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "model:probe": "tsx --conditions=development scripts/probe-model.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@astryxdesign/theme-neutral": "0.6.3",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@earendil-works/pi-ai": "0.85.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "^10.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@stylexjs/stylex": "0.19.0",
    "ajv": "^8.17.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.5",
    "imapflow": "2.0.7",
    "jose": "^6.2.12",
    "mailauth": "7.1.0",
    "mailparser": "^3.9.28",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typebox": "1.3.33",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.16.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "prettier": "3.6.2",
    "smtp-server": "3.19.13",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0"
  },
  "description": "A durable, permission-aware task runtime with pluggable modules and model adapters",
  "license": "Apache-2.0",
  "keywords": [
    "agent",
    "workflow",
    "durable-execution",
    "typescript"
  ],
  "exports": {
    "./sdk": {
      "types": "./packages/sdk/index.ts",
      "development": "./packages/sdk/index.ts",
      "default": "./dist/packages/sdk/index.js"
    },
    "./client": {
      "types": "./packages/api/client.ts",
      "development": "./packages/api/client.ts",
      "default": "./dist/packages/api/client.js"
    },
    "./ui": {
      "types": "./packages/ui/index.ts",
      "development": "./packages/ui/index.ts",
      "default": "./dist/packages/ui/index.js"
    }
  }
}
