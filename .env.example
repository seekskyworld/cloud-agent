DATABASE_URL=postgres://cloud_agent:replace-me@127.0.0.1:5432/cloud_agent
HOST=127.0.0.1
PORT=3100
AUTH_MODE=none
LOCAL_WORKSPACE=default
LOCAL_PRINCIPAL=owner
MODEL_MODE=demo
WORKER_CONCURRENCY=2
# 后续启用 AUTH_MODE=token 时才需要至少 24 字符的 BOOTSTRAP_TOKEN。
# BOOTSTRAP_TOKEN=
# MODEL_MODE=pi 时配置模型与每百万 token 美元单价（估算成本）。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini
# LLM_INPUT_PRICE=1
# LLM_OUTPUT_PRICE=4

# 可选邮件通道，详见 docs/operations.md；绑定已有身份并显式授予 mail:use。
MAIL_MODE=disabled
MAIL_SEND_ENABLED=false
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX=agent@example.com
# MAIL_WORKSPACE=default
# MAIL_BINDINGS={"person@example.com":"owner"}
# AGENTMAIL_RECEIVE_MODE=poll
# Webhook 可选；需要 HTTPS /hooks/agentmail、独立 Bearer 与服务商签名密钥。
# AGENTMAIL_WEBHOOK_TOKEN=
# AGENTMAIL_WEBHOOK_SECRET=

# 仅手动 pnpm archive 使用；默认不执行归档，--apply 前先预览。
# RETENTION_DAYS=90
# ARCHIVE_BATCH_SIZE=20

# 多账户模式（与旧 MAIL_MODE=agentmail 二选一）；完整两供应商示例见 docs/operations.md。
# MAIL_MODE=accounts
# MAIL_ACCOUNTS='[{"id":"service","provider":"agentmail","address":"agent@example.com","inbox":"agent@example.com","workspace":"default","bindings":{"person@example.com":"owner"},"credential":"service-key","sendEnabled":false}]'
# MAIL_CREDENTIALS='{"service-key":{"kind":"api-key","apiKey":"replace-me"}}'
# 或读取 0600/0400 私有 JSON 文件；Compose 需同时给 API/Worker 只读挂载所在目录。
# MAIL_CREDENTIALS_FILE=/run/mail/credentials.json

# 独立业务包默认关闭；依赖绑定及 starter 文件示例见 docs/extending.md。
BUSINESS_PACKAGES=[]

# 可选运行治理，详见 docs/operations.md。
# DEPLOYMENT_MANAGED=false
# ARTIFACT_STORES=[]
# EXECUTION_POOL=default
# EXECUTION_LABELS=[]
# TENANT_RATE_PER_MINUTE=120
# COST_POLICY={"workspaces":{"default":10}}
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces
# MEMORY_ENABLED=false
# OIDC_AUTH=（仅 AUTH_MODE=token，配置见运维指南）
# MIGRATION_DATABASE_URL=（部署/维护账号，不提供给 API/Worker）
# DATA_RETENTION_DAYS=90
